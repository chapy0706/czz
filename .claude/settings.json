{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm *)",
			"Bash(make *)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(rg *)",
			"Bash(grep *)",
			"Bash(ls *)",
			"Bash(tree *)",
			"Bash(cat *)"
		],
		"ask": [
			"Bash(git commit *)",
			"Bash(pnpm add *)",
			"Bash(pnpm dlx *)",
			"Bash(docker *)"
		],
		"deny": [
			"Bash(rm -rf *)",
			"Bash(git push *)",
			"Bash(git reset --hard *)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Read(**/.env*)",
			"Read(**/secrets/**)"
		],
		"disableBypassPermissionsMode": "disable",
		"defaultMode": "default"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{ "type": "command", "command": ".claude/hooks/block-dangerous.sh" }
				]
			},
			{
				"matcher": "Read",
				"hooks": [
					{ "type": "command", "command": ".claude/hooks/protect-secrets.sh" }
				]
			}
		]
	}
}

{
  "name": "czz",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:user": "pnpm --filter user-app dev",
    "dev:admin": "pnpm --filter admin-app dev",
    "build:user": "pnpm --filter user-app build",
    "build:admin": "pnpm --filter admin-app build",
    "start:user": "pnpm --filter user-app start",
    "start:admin": "pnpm --filter admin-app start",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "e2e": "node ./scripts/run-e2e.mjs",
    "e2e:ui": "E2E_BASE_URL=http://localhost:3100 pnpm -C e2e test:ui",
    "e2e:test": "pnpm -C e2e test",
    "e2e:attach": "E2E_ATTACH=1 node ./scripts/run-e2e.mjs",
    "e2e:server": "pnpm -C apps/user dev -- -p 3100",
    "e2e:install": "pnpm -C e2e exec playwright install --with-deps",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.45.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.33.0",
    "lucide-react": "^0.556.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "postgres": "^3.4.4"
  }
}

{
	"name": "czz",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev:user": "pnpm -C apps/user dev",
		"dev:admin": "pnpm -C apps/admin dev",
		"build:user": "pnpm -C apps/user build",
		"build:admin": "pnpm -C apps/admin build",
		"check": "biome check .",
		"check:write": "biome check . --write --unsafe",
		"typecheck:apps": "tsc -p apps/user/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit",
		"typecheck:packages": "tsc -p packages/dsl-core/tsconfig.json --noEmit",
		"typecheck": "pnpm -w typecheck:packages && pnpm -w typecheck:apps",
		"test": "pnpm -w test:unit",
		"test:unit": "vitest run",
		"test:watch": "vitest --watch",
		"e2e": "node ./scripts/run-e2e.mjs",
		"e2e:ui": "E2E_BASE_URL=http://localhost:3100 pnpm -C e2e test:ui"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"typescript": "5.8.3",
		"vitest": "2.1.9"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.2.3",
			"@types/react-dom": "19.2.3"
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.33.0",
		"postgres": "^3.4.7",
		"tailwind-merge": "^3.4.0"
	}
}

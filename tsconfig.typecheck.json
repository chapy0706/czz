{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler"
	},
	"include": [
		"packages/*/src/**/*.ts",
		"packages/*/src/**/*.tsx",
		"infra/**/*.ts"
	],
	"exclude": [
		"**/node_modules/**",
		"**/.next/**",
		"**/dist/**",
		"**/out/**",
		"e2e/**"
	]
}

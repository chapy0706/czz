// /tsconfig.typecheck.json
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/**/src/**/*.ts",
    "apps/**/src/**/*.tsx",
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.tsx"
  ],
  "exclude": ["**/node_modules/**", "**/.next/**", "**/dist/**", "**/out/**"]
}
